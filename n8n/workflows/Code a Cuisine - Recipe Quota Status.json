      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        624,
        0
      ],
      "id": "1a8a4462-0f55-499b-bf2c-55ffd21a04f4",
      "name": "Firebase - Get System Quota"
    },
    {
      "parameters": {
        "jsCode": "const ipQuota = $('Firebase - Get IP Quota').item.json ?? {};\nconst systemQuota = $('Firebase - Get System Quota').item.json ?? {};\n\nconst ipRemaining = Math.max(0, 3 - Number(ipQuota.used ?? 0));\nconst systemRemaining = Math.max(0, 12 - Number(systemQuota.used ?? 0));\nconst remainingGenerations = Math.min(ipRemaining, systemRemaining);\n\nreturn [{ json: { remainingGenerations } }];"
      },
      "type": "n8n-nodes-base.code",
