      "parameters": {
        "url": "={{ 'https://code-a-cuisine-805b1-default-rtdb.europe-west1.firebasedatabase.app/quota/dailyByIp/' + $json.dayKey + '/' + $json.ipHash + '.json' }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
